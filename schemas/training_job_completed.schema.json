{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tg-news.local/schemas/training_job_completed.schema.json",
  "title": "Training Job Completed",
  "type": "object",
  "required": ["event_id", "event_type", "event_timestamp", "event_version", "source_system", "payload"],
  "properties": {
    "event_id": { "type": "string" },
    "event_type": { "const": "training_job_completed" },
    "event_timestamp": { "type": "string", "format": "date-time" },
    "event_version": { "type": "string" },
    "source_system": { "type": "string" },
    "trace_id": { "type": "string" },
    "payload": {
      "type": "object",
      "required": ["training_job_id", "model_version_id", "status", "metrics"],
      "properties": {
        "training_job_id": { "type": "string" },
        "model_version_id": { "type": "string" },
        "status": { "const": "completed" },
        "metrics": { "type": "object" },
        "artifact_path": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
