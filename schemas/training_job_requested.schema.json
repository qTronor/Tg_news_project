{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tg-news.local/schemas/training_job_requested.schema.json",
  "title": "Training Job Requested",
  "type": "object",
  "required": ["event_id", "event_type", "event_timestamp", "event_version", "source_system", "payload"],
  "properties": {
    "event_id": { "type": "string" },
    "event_type": { "const": "training_job_requested" },
    "event_timestamp": { "type": "string", "format": "date-time" },
    "event_version": { "type": "string" },
    "source_system": { "type": "string" },
    "trace_id": { "type": "string" },
    "payload": {
      "type": "object",
      "required": ["training_job_id", "dataset_id", "task_type", "base_model", "consent_to_train"],
      "properties": {
        "training_job_id": { "type": "string" },
        "dataset_id": { "type": "string" },
        "task_type": {
          "enum": ["topic_classification", "sentiment_classification", "embedding_finetuning", "ner_finetuning"]
        },
        "base_model": { "type": "string" },
        "training_config": { "type": "object" },
        "consent_to_train": { "const": true },
        "requested_by": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
